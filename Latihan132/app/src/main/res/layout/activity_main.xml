<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7FB">

    <!-- AREA KONTEN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="72dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pengingat Tugas&#10;Jhodie"
            android:textAlignment="center"
            android:textColor="#1E293B"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Atur pengingat tugas agar tidak melewatkan pekerjaan penting."
            android:textAlignment="center"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/taskInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukkan nama tugas"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <TimePicker
            android:id="@+id/timePicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/scheduleButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Jadwalkan Pengingat"
            android:textAllCaps="false" />

    </LinearLayout>

    <!-- FOOTER WATERMARK -->
    <TextView
        android:id="@+id/txtFooter"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="#01b0e1"
        android:gravity="center"
        android:text="© 2026 Jhodie Naufal Kertoprodjo"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

</LinearLayout>