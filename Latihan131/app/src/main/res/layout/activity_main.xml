<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7FB">

    <!-- AREA KONTEN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="72dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pengingat Minum Air&#10;Jhodie"
            android:textAlignment="center"
            android:textColor="#1E293B"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jaga tubuh tetap terhidrasi dengan pengingat minum air secara berkala."
            android:textAlignment="center"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="34dp"/>

        <TextView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:gravity="center"
            android:background="#DFF8FF"
            android:text="💧"
            android:textSize="52sp"
            android:layout_marginBottom="34dp"/>

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Mulai Pengingat"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Hentikan Pengingat"
            android:textAllCaps="false"
            android:textSize="15sp"/>

    </LinearLayout>

    <!-- FOOTER WATERMARK -->
    <TextView
        android:id="@+id/txtFooter"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="#01b0e1"
        android:gravity="center"
        android:text="© 2026 Jhodie Naufal Kertoprodjo"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

</LinearLayout>